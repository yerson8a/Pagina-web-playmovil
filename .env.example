# ==============================================================
#  Play Móvil — variables de entorno
#  Copia este archivo como .env.local y completa los valores.
#  En Vercel: Project Settings → Environment Variables.
#  Todas son opcionales: si no las defines, se usan los valores
#  por defecto de lib/site.ts.
# ==============================================================

# Número de WhatsApp en formato internacional, sin "+" ni espacios.
# Colombia = 57. Ejemplo para 311 306 7000:
NEXT_PUBLIC_WHATSAPP_NUMBER=573113067000

# URL del perfil de Instagram.
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/playmovil15

# URL pública del sitio (usada para SEO y metadatos).
NEXT_PUBLIC_SITE_URL=https://www.playmovil.store
